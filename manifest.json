{
  "manifest_version": 2,
  "name": "FoxHub: Gmail, Social & Media Sidebar",
  "short_name": "FoxHub",
  "version": "2.7.9",
  "description": "Fast local multi-account Gmail, social, and media sidebar for Firefox.",
  "author": "FoxHub",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "FoxHub",
    "default_popup": "src/popup/popup.html"
  },
  "sidebar_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "FoxHub",
    "default_panel": "src/popup/popup.html?sidebar=1",
    "open_at_install": true
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "MacCtrl+Shift+F"
      },
      "description": "Open FoxHub Floating Dropdown Popup (above webpage)"
    },
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "Toggle FoxHub Left Sidebar"
    },
    "open-foxhub-popout": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "MacCtrl+Shift+W"
      },
      "description": "Open FoxHub Desktop Popout Window"
    },
    "foxhub-app-slot-1": {
      "description": "Quick Launch Assigned FoxHub App (Slot 1)"
    },
    "foxhub-app-slot-2": {
      "description": "Quick Launch Assigned FoxHub App (Slot 2)"
    },
    "foxhub-app-slot-3": {
      "description": "Quick Launch Assigned FoxHub App (Slot 3)"
    },
    "foxhub-app-slot-4": {
      "description": "Quick Launch Assigned FoxHub App (Slot 4)"
    },
    "foxhub-app-slot-5": {
      "description": "Quick Launch Assigned FoxHub App (Slot 5)"
    },
    "foxhub-app-slot-6": {
      "description": "Quick Launch Assigned FoxHub App (Slot 6)"
    },
    "foxhub-app-slot-7": {
      "description": "Quick Launch Assigned FoxHub App (Slot 7)"
    },
    "foxhub-app-slot-8": {
      "description": "Quick Launch Assigned FoxHub App (Slot 8)"
    },
    "foxhub-app-slot-9": {
      "description": "Quick Launch Assigned FoxHub App (Slot 9)"
    },
    "foxhub-app-slot-10": {
      "description": "Quick Launch Assigned FoxHub App (Slot 10)"
    },
    "foxhub-app-slot-11": {
      "description": "Quick Launch Assigned FoxHub App (Slot 11)"
    },
    "foxhub-app-slot-12": {
      "description": "Quick Launch Assigned FoxHub App (Slot 12)"
    }
  },
  "background": {
    "page": "src/background/background.html",
    "persistent": true
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "src/shared/media-frame-optimizer.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "<all_urls>",
    "*://mail.google.com/*",
    "*://accounts.google.com/*",
    "https://www.googleapis.com/*",
    "cookies",
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "identity",
    "webRequest",
    "webRequestBlocking"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pocketmail-local@workspace.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
